{
  "contract_version": "uniswap-v3-execution-order/v1",
  "execution_model": {
    "dynamic_data_sources": {
      "activation_scope": "entire_creation_block",
      "creation_log_ordinal_gate": false,
      "host_order": "data-source creation order",
      "host_scope": "only hosts created in the current dynamic stage",
      "raw_global_flattening": false,
      "stage_batch": "successfully instantiated nonduplicate hosts produced by the prior stage, preserving encounter order",
      "stage_scope": "stage_local",
      "traversal": "breadth_first",
      "trigger_source": "refetch and rematch the whole creation block for each new-host batch"
    },
    "failure_modes": {
      "deterministic_fatal": "discard the failing mapping handler; filter only entity modifications to the PoI entity, still pass persisted data sources and deterministic errors to the block transaction, advance the failed block pointer, then stop",
      "deterministic_nonfatal": "discard the failing mapping handler's entity and created-data-source changes; retain successful modifications and submit the block/PoI transaction; continuation is conditional on no fail-fast cancellation",
      "deterministic_nonfatal_fail_fast": "after transaction, an unsynced deployment may still be canceled by maybe_cancel",
      "pretransaction_mapping_decode_or_dynamic_stage_unknown": "return before block transaction; do not commit that partial block state"
    },
    "handler_rollback": {
      "block_shared_vid_sequence": true,
      "chain_reorg_replay": "entity versions created at or after the first reverted block are removed; prior versions closed there are unclamped; replay constructs a fresh block-scoped sequence generator",
      "created_data_sources_discarded_on_deterministic_error": true,
      "discard_scope": [
        "handler entity updates",
        "handler-created data sources"
      ],
      "entity_changes_buffered_per_mapping_handler": true,
      "entity_changes_discarded_on_deterministic_error": true,
      "entity_vid_distinct_from_dynamic_datasource_metadata_vid": true,
      "not_rewound": [
        "VID sequence",
        "auto-ID sequence",
        "proof-of-indexing events",
        "write-capacity accounting",
        "metrics",
        "cache reads"
      ],
      "vid_allocation": "each EntityCache::set call that reaches the allocation point receives a fresh VID; discarding that handler's entity buffer does not reclaim it",
      "vid_reserved_sequence_start": 100,
      "vid_sequence_rewinds_on_handler_rollback": false
    },
    "proof_of_indexing": {
      "deterministic_error": "append DeterministicError with redacted_events equal to PoI events since the runnable-trigger boundary",
      "failed_handler_set_entity_events_physically_erased": false,
      "handler_boundary": "once per runnable raw trigger before its ordered hosted mapping handlers",
      "redaction_encoding": "retained SetEntity events plus appended counter",
      "set_entity_precedes_vid_allocation": true,
      "set_entity_written_before_entity_cache_set": true
    },
    "scope": "Ethereum onchain triggers and mapping handlers in Graph Node v0.44.0",
    "stage_one": {
      "ethereum_comparator": {
        "block_start": "before every non-Start trigger",
        "call_vs_call": "ascending transaction index",
        "log_vs_call_different_transaction": "ascending transaction index",
        "log_vs_call_same_transaction": "log before call",
        "log_vs_log": "ascending global log index",
        "non_start_block_triggers": "after calls and logs; relative input order is retained when the block-trigger comparator is equal"
      },
      "handler_order": "for each ordered raw trigger, matching hosts execute in insertion order",
      "initial_host_order": "successfully instantiated nonduplicate hosts encountered from manifest data sources in manifest order, followed by stored dynamic data sources ordered by creation block then database vid",
      "input": "sorted and deduplicated BlockWithTriggers for the block",
      "ordering_scope": "stage_local"
    }
  },
