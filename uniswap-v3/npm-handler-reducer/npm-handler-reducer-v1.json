    "post_fatal_execution": "intentionally not modeled: Graph continues remaining runnable triggers and breadth-first dynamic stages and may encounter a later retryable failure that aborts before the block transaction; otherwise the fatal transaction filters user modifications to PoI, passes persisted data sources and deterministic errors, advances the failed block pointer, and stops the deployment",
    "graph_call_scope": "one reducer invocation and its exact block pointer; hash-bound when available and number fallback otherwise; never event ordinal",
    "graph_call_cache": "invocation-local raw results keyed by target address and exact positions or getPool calldata",
    "token_read_scope": "event ordinal; never block-only",
    "provisional_identity": "a new getPosition identity remains provisional while its first loadTransaction is committed to joint scratch; a later normal return may retain only Transaction",
    "snapshot_id": "position token id plus # plus block number; the last accepted same-position event in a block overwrites it",
