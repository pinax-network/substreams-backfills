@@ -0,0 +1,456 @@
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde::Deserialize;
+use sha2::{Digest, Sha256};
+use substreams::errors::Error;
+
+const CONFIG_VERSION: &str = "uniswap-v3-chain-config/v1";
+const MAINNET_SHA256: &str = "30f5caf9ee8906a8886dc103e55286b9d5b6dbd8784d1c97d21b9a38b266bb55";
+const BASE_SHA256: &str = "2eeed82547cea2d8e6c6adb9b3770bd8f8bbdde3b43ce4c7a5410325cf9b2832";
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ChainConfig {
+    pub format_version: u32,
+    pub config_version: String,
+    pub network: String,
+    pub deployment: String,
+    pub schema_cid: String,
+    pub graft: GraftConfig,
+    pub contracts: ContractConfig,
+    pub initial_blocks: InitialBlockConfig,
+    pub pricing: PricingConfig,
+    pub filters: FilterConfig,
+    pub static_token_metadata: Vec<StaticTokenMetadata>,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct GraftConfig {
+    pub base: String,
+    pub block: u64,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct ContractConfig {
+    pub factory: String,
+    pub factory_entity_id: String,
+    pub nonfungible_position_manager: String,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct InitialBlockConfig {
+    pub module: u64,
+    pub factory: u64,
+    pub factory_creation: u64,
+    pub nonfungible_position_manager: u64,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct PricingConfig {
+    pub wrapped_native_token: String,
+    pub usd_reference_pool: String,
+    pub usd_reference_token: String,
+    pub usd_reference_token_side: u8,
+    pub minimum_native_locked: String,
+    pub stablecoins: Vec<String>,
+    pub whitelist_tokens: Vec<String>,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct FilterConfig {
+    pub ignored_pools: Vec<String>,
+    pub swap_ignored_pools: Vec<String>,
+}
+
+#[derive(Debug, Clone, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct StaticTokenMetadata {
+    pub address: String,
+    pub name: String,
+    pub symbol: String,
+    pub decimals: u64,
+}
+
+impl ChainConfig {
+    pub fn from_params(input: &str) -> Result<Self, Error> {
+        let selector = Selector::parse(input)?;
+        let (raw, expected_network) = match selector.network.as_str() {
+            "mainnet" => (include_str!("../configs/mainnet-v1.json"), "mainnet"),
+            "base" => (include_str!("../configs/base-v1.json"), "base"),
+            other => return Err(Error::msg(format!("unknown ChainConfig network `{other}`"))),
+        };
+
+        let actual_digest = hex::encode(Sha256::digest(raw.as_bytes()));
+        if selector.sha256 != actual_digest {
+            return Err(Error::msg(format!(
+                "ChainConfig digest mismatch: selector has `{}`, embedded config is `{actual_digest}`",
+                selector.sha256
+            )));
+        }
+
+        let config = Self::parse_and_validate(raw)?;
+        if config.network != expected_network {
+            return Err(Error::msg(format!(
+                "ChainConfig network mismatch: selector has `{expected_network}`, config has `{}`",
+                config.network
+            )));
+        }
+        Ok(config)
+    }
+
+    fn parse_and_validate(raw: &str) -> Result<Self, Error> {
+        let config: Self = serde_json::from_str(raw)
+            .map_err(|error| Error::msg(format!("invalid ChainConfig JSON: {error}")))?;
+        config.validate()?;
+        Ok(config)
+    }
+
+    fn validate(&self) -> Result<(), Error> {
+        if self.format_version != 1 || self.config_version != CONFIG_VERSION {
+            return Err(Error::msg(format!(
+                "unsupported ChainConfig version `{}`/{}",
+                self.config_version, self.format_version
+            )));
+        }
+        if !matches!(self.network.as_str(), "mainnet" | "base") {
+            return Err(Error::msg(format!("unsupported network `{}`", self.network)));
+        }
+        validate_cid("deployment", &self.deployment)?;
+        validate_cid("schema_cid", &self.schema_cid)?;
+        validate_cid("graft.base", &self.graft.base)?;
+        if self.graft.block == 0 {
+            return Err(Error::msg("graft.block must be non-zero"));
+        }
+
+        validate_address("contracts.factory", &self.contracts.factory)?;
+        let entity_address = self
+            .contracts
+            .factory_entity_id
+            .strip_prefix("0x")
+            .ok_or_else(|| Error::msg("contracts.factory_entity_id must start with 0x"))?;
+        if entity_address.len() != 40
+            || !entity_address.bytes().all(|byte| byte.is_ascii_hexdigit())
+            || !entity_address.eq_ignore_ascii_case(&self.contracts.factory)
+        {
+            return Err(Error::msg(
+                "contracts.factory_entity_id must encode contracts.factory",
+            ));
+        }
+        validate_address(
+            "contracts.nonfungible_position_manager",
+            &self.contracts.nonfungible_position_manager,
+        )?;
+        if self.contracts.factory == self.contracts.nonfungible_position_manager {
+            return Err(Error::msg("factory and position manager must differ"));
+        }
+
+        let starts = &self.initial_blocks;
+        if starts.module == 0
+            || starts.factory == 0
+            || starts.factory_creation == 0
+            || starts.nonfungible_position_manager == 0
+        {
+            return Err(Error::msg("all initial blocks must be non-zero"));
+        }
+        if starts.module != starts.factory || starts.factory_creation != starts.factory {
+            return Err(Error::msg(
+                "module, factory, and factory-creation initial blocks must match",
+            ));
+        }
+        if starts.nonfungible_position_manager < starts.module {
+            return Err(Error::msg(
+                "position-manager initial block cannot precede the module initial block",
+            ));
+        }
+
+        validate_address(
+            "pricing.wrapped_native_token",
+            &self.pricing.wrapped_native_token,
+        )?;
+        validate_address("pricing.usd_reference_pool", &self.pricing.usd_reference_pool)?;
+        validate_address(
+            "pricing.usd_reference_token",
+            &self.pricing.usd_reference_token,
+        )?;
+        if self.pricing.usd_reference_token_side > 1 {
+            return Err(Error::msg("pricing.usd_reference_token_side must be 0 or 1"));
+        }
+        self.pricing
+            .minimum_native_locked
+            .parse::<u64>()
+            .map_err(|_| Error::msg("pricing.minimum_native_locked must be a non-negative integer"))?;
+        validate_address_list("pricing.stablecoins", &self.pricing.stablecoins, false)?;
+        validate_address_list(
+            "pricing.whitelist_tokens",
+            &self.pricing.whitelist_tokens,
+            false,
+        )?;
+        if !self
+            .pricing
+            .whitelist_tokens
+            .contains(&self.pricing.wrapped_native_token)
+        {
+            return Err(Error::msg("wrapped native token must be whitelisted"));
+        }
+        if !self
+            .pricing
+            .whitelist_tokens
+            .contains(&self.pricing.usd_reference_token)
+        {
+            return Err(Error::msg("USD reference token must be whitelisted"));
+        }
+        if self.pricing.wrapped_native_token == self.pricing.usd_reference_token {
+            return Err(Error::msg(
+                "wrapped native token and USD reference token must differ",
+            ));
+        }
+
+        validate_address_list("filters.ignored_pools", &self.filters.ignored_pools, true)?;
+        validate_address_list(
+            "filters.swap_ignored_pools",
+            &self.filters.swap_ignored_pools,
+            true,
+        )?;
+        if self
+            .filters
+            .ignored_pools
+            .iter()
+            .any(|pool| self.filters.swap_ignored_pools.contains(pool))
+        {
+            return Err(Error::msg(
+                "ignored pools and swap-only ignored pools must not overlap",
+            ));
+        }
+        if self.filters.ignored_pools.contains(&self.pricing.usd_reference_pool)
+            || self
+                .filters
+                .swap_ignored_pools
+                .contains(&self.pricing.usd_reference_pool)
+        {
+            return Err(Error::msg("USD reference pool cannot be filtered"));
+        }
+
+        let mut metadata_addresses = BTreeSet::new();
+        for token in &self.static_token_metadata {
+            validate_address("static_token_metadata.address", &token.address)?;
+            if !metadata_addresses.insert(&token.address) {
+                return Err(Error::msg(format!(
+                    "duplicate static token metadata for `{}`",
+                    token.address
+                )));
+            }
+            if token.name.is_empty() || token.symbol.is_empty() || token.decimals >= 255 {
+                return Err(Error::msg(format!(
+                    "invalid static token metadata for `{}`",
+                    token.address
+                )));
+            }
+        }
+        Ok(())
+    }
+
+    pub fn factory_address(&self) -> Vec<u8> {
+        decode_address(&self.contracts.factory)
+    }
+
+    pub fn position_manager_address(&self) -> Vec<u8> {
+        decode_address(&self.contracts.nonfungible_position_manager)
+    }
+
+    pub fn is_whitelisted(&self, address: &str) -> bool {
+        self.pricing.whitelist_tokens.iter().any(|item| item == address)
+    }
+
+    pub fn is_stablecoin(&self, address: &str) -> bool {
+        self.pricing.stablecoins.iter().any(|item| item == address)
+    }
+
+    pub fn ignores_pool(&self, address: &str) -> bool {
+        self.filters.ignored_pools.iter().any(|item| item == address)
+    }
+
+    pub fn ignores_swap(&self, address: &str) -> bool {
+        self.ignores_pool(address)
+            || self
+                .filters
+                .swap_ignored_pools
+                .iter()
+                .any(|item| item == address)
+    }
+}
+
+struct Selector {
+    network: String,
+    sha256: String,
+}
+
+impl Selector {
+    fn parse(input: &str) -> Result<Self, Error> {
+        if input.is_empty() {
+            return Err(Error::msg("missing ChainConfig selector"));
+        }
+        let mut values = BTreeMap::new();
+        for pair in input.split(';') {
+            let (key, value) = pair
+                .split_once('=')
+                .ok_or_else(|| Error::msg(format!("malformed ChainConfig selector `{pair}`")))?;
+            if key.is_empty() || value.is_empty() {
+                return Err(Error::msg(format!("malformed ChainConfig selector `{pair}`")));
+            }
+            if values.insert(key, value).is_some() {
+                return Err(Error::msg(format!("duplicate ChainConfig selector key `{key}`")));
+            }
+        }
+
+        const KEYS: [&str; 3] = ["version", "network", "sha256"];
+        let unknown = values
+            .keys()
+            .filter(|key| !KEYS.contains(key))
+            .copied()
+            .collect::<Vec<_>>();
+        if !unknown.is_empty() {
+            return Err(Error::msg(format!(
+                "unknown ChainConfig selector key(s): {}",
+                unknown.join(", ")
+            )));
+        }
+        for key in KEYS {
+            if !values.contains_key(key) {
+                return Err(Error::msg(format!("missing ChainConfig selector key `{key}`")));
+            }
+        }
+        if values["version"] != "1" {
+            return Err(Error::msg(format!(
+                "unsupported ChainConfig selector version `{}`",
+                values["version"]
+            )));
+        }
+
+        let network = values["network"].to_string();
+        let sha256 = values["sha256"].to_string();
+        let expected = match network.as_str() {
+            "mainnet" => MAINNET_SHA256,
+            "base" => BASE_SHA256,
+            other => return Err(Error::msg(format!("unknown ChainConfig network `{other}`"))),
+        };
+        if sha256 != expected {
+            return Err(Error::msg(format!(
+                "unapproved ChainConfig digest `{sha256}` for `{network}`"
+            )));
+        }
+        Ok(Self { network, sha256 })
+    }
+}
+
+fn validate_cid(field: &str, value: &str) -> Result<(), Error> {
+    if value.len() != 46 || !value.starts_with("Qm") || !value.bytes().all(|byte| byte.is_ascii_alphanumeric()) {
+        return Err(Error::msg(format!("{field} must be a CIDv0 string")));
+    }
+    Ok(())
+}
+
+fn validate_address(field: &str, value: &str) -> Result<(), Error> {
+    if value.len() != 40
+        || !value.bytes().all(|byte| byte.is_ascii_hexdigit())
+        || value.bytes().any(|byte| byte.is_ascii_uppercase())
+    {
+        return Err(Error::msg(format!(
+            "{field} must be a lowercase 20-byte hex address without 0x"
+        )));
+    }
+    Ok(())
+}
+
+fn validate_address_list(field: &str, values: &[String], allow_empty: bool) -> Result<(), Error> {
+    if values.is_empty() && !allow_empty {
+        return Err(Error::msg(format!("{field} cannot be empty")));
+    }
+    let mut unique = BTreeSet::new();
+    for value in values {
+        validate_address(field, value)?;
+        if !unique.insert(value) {
+            return Err(Error::msg(format!("{field} contains duplicate `{value}`")));
+        }
+    }
+    Ok(())
+}
+
+fn decode_address(value: &str) -> Vec<u8> {
+    hex::decode(value).expect("validated ChainConfig address")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const MAINNET_PARAMS: &str = "version=1;network=mainnet;sha256=30f5caf9ee8906a8886dc103e55286b9d5b6dbd8784d1c97d21b9a38b266bb55";
+    const BASE_PARAMS: &str = "version=1;network=base;sha256=2eeed82547cea2d8e6c6adb9b3770bd8f8bbdde3b43ce4c7a5410325cf9b2832";
+
+    #[test]
+    fn loads_both_pinned_configs() {
+        let mainnet = ChainConfig::from_params(MAINNET_PARAMS).unwrap();
+        let base = ChainConfig::from_params(BASE_PARAMS).unwrap();
+        assert_eq!(mainnet.network, "mainnet");
+        assert_eq!(base.network, "base");
+        assert_ne!(mainnet.contracts.factory, base.contracts.factory);
+        assert_ne!(mainnet.pricing.wrapped_native_token, base.pricing.wrapped_native_token);
+
+        let dgd = hex::decode("e0b7927c4af23765cb51314a0e0521a9645f0e2a").unwrap();
+        assert_eq!(
+            crate::utils::get_static_uniswap_tokens(&mainnet, &dgd)
+                .unwrap()
+                .symbol,
+            "DGD"
+        );
+        assert!(crate::utils::get_static_uniswap_tokens(&base, &dgd).is_none());
+    }
+
+    #[test]
+    fn rejects_missing_unknown_duplicate_and_unapproved_selectors() {
+        for params in [
+            "",
+            "version=1;network=base",
+            "version=1;network=base;sha256=abc;extra=no",
+            "version=1;network=base;network=mainnet;sha256=abc",
+            "version=2;network=base;sha256=abc",
+            "version=1;network=unknown;sha256=abc",
+            "version=1;network=base;sha256=abc",
+        ] {
+            assert!(ChainConfig::from_params(params).is_err(), "accepted `{params}`");
+        }
+    }
+
+    #[test]
+    fn rejects_malformed_incomplete_and_inconsistent_json() {
+        assert!(ChainConfig::parse_and_validate("{}").is_err());
+        assert!(ChainConfig::parse_and_validate("not-json").is_err());
+
+        let raw = include_str!("../configs/base-v1.json");
+        let inconsistent = raw.replace("\"module\": 1371713", "\"module\": 1371712");
+        assert!(ChainConfig::parse_and_validate(&inconsistent).is_err());
+
+        let malformed_address = raw.replace(
+            "33128a8fc17869897dce68ed026d694621f6fdfd",
+            "0x33128a8fC17869897dcE68Ed026d694621f6FDfD",
+        );
+        assert!(ChainConfig::parse_and_validate(&malformed_address).is_err());
+    }
+
+    #[test]
+    fn pins_deployed_base_oddities() {
+        let base = ChainConfig::from_params(BASE_PARAMS).unwrap();
+        assert_eq!(base.pricing.minimum_native_locked, "1");
+        assert_eq!(
+            base.pricing.stablecoins,
+            ["b97ef9ef8734c71904d8002f8b6bc66dd9c48a6e"]
+        );
+        assert!(base.ignores_pool("8fe8d9bb8eeba3ed688069c3d6b556c9ca258248"));
+        assert!(base.ignores_swap("9663f2ca0454accad3e094448ea6f77443880454"));
+        assert!(base.static_token_metadata.is_empty());
+    }
+}
