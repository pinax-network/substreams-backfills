+pub fn extract_writer_events(config: &ChainConfig, block: &Block) -> Result<WriterEvents, Error> {
+    let network = Network::parse(&config.network)?;
+    let profiles = SegmentProfiles::embedded(config)?;
+    let profile = profiles.select(network, block.number)?;
+    let mut output = WriterEvents {
+        network: config.network.clone(),
+        block_number: block.number,
+        segment_id: profile.segment_id.clone(),
+        source_writer_contract_sha256: SOURCE_WRITER_CONTRACT_SHA256.to_string(),
+        segment_semantic_contract_sha256: profile.semantic_contract_sha256.clone(),
+        ..Default::default()
+    };
+    if block.number < config.initial_blocks.nonfungible_position_manager {
+        return Ok(output);
+    }
+
+    let manager = config.position_manager_address();
+    let mut ordinals = BTreeSet::new();
+    for log_view in block.logs() {
+        let log = log_view.log;
+        if log.address != manager {
+            continue;
+        }
+        let Some(event) = decode_writer_log(log)? else {
+            continue;
+        };
+        let transaction_hash = &log_view.receipt.transaction.hash;
+        if transaction_hash.len() != 32 {
+            return Err(Error::msg(format!(
+                "writer-event transaction hash must be 32 bytes at ordinal {}",
+                log.ordinal
+            )));
+        }
+        if !ordinals.insert(log.ordinal) {
+            return Err(Error::msg(format!("duplicate writer-event ordinal {}", log.ordinal)));
+        }
+        output.events.push(WriterEvent {
+            ordinal: log.ordinal,
+            transaction_hash: transaction_hash.clone(),
+            block_number: block.number,
+            transaction_log_index: log.index,
+            block_log_index: log.block_index,
+            contract_address: log.address.clone(),
+            event: Some(event),
+        });
+    }
+    output.events.sort_by_key(|event| event.ordinal);
+    Ok(output)
+}
+
+pub fn decode_writer_log(log: &Log) -> Result<Option<Event>, Error> {
+    let Some(topic) = log.topics.first() else {
+        return Ok(None);
+    };
+    match hex::encode(topic).as_str() {
+        INCREASE_TOPIC => {
+            require_shape(log, 2, 96, "IncreaseLiquidity")?;
+            let event = IncreaseLiquidity::decode(log)
+                .map_err(|_| Error::msg("malformed recognized IncreaseLiquidity event"))?;
+            Ok(Some(Event::IncreaseLiquidity(RawIncreaseLiquidity {
+                token_id: event.token_id.to_string(),
+                liquidity: event.liquidity.to_string(),
+                amount0: event.amount0.to_string(),
+                amount1: event.amount1.to_string(),
+            })))
+        }
+        DECREASE_TOPIC => {
+            require_shape(log, 2, 96, "DecreaseLiquidity")?;
+            let event = DecreaseLiquidity::decode(log)
+                .map_err(|_| Error::msg("malformed recognized DecreaseLiquidity event"))?;
+            Ok(Some(Event::DecreaseLiquidity(RawDecreaseLiquidity {
+                token_id: event.token_id.to_string(),
+                liquidity: event.liquidity.to_string(),
+                amount0: event.amount0.to_string(),
+                amount1: event.amount1.to_string(),
+            })))
+        }
+        COLLECT_TOPIC => {
+            require_shape(log, 2, 96, "Collect")?;
+            let event = Collect::decode(log).map_err(|_| Error::msg("malformed recognized Collect event"))?;
+            Ok(Some(Event::Collect(RawCollect {
+                token_id: event.token_id.to_string(),
+                recipient: event.recipient,
+                amount0: event.amount0.to_string(),
+                amount1: event.amount1.to_string(),
+            })))
+        }
+        TRANSFER_TOPIC => {
+            require_shape(log, 4, 0, "Transfer")?;
+            let event = Transfer::decode(log).map_err(|_| Error::msg("malformed recognized Transfer event"))?;
+            Ok(Some(Event::Transfer(RawTransfer {
+                from: event.from,
+                to: event.to,
+                token_id: event.token_id.to_string(),
+            })))
+        }
+        _ => Ok(None),
+    }
+}
+
+fn require_shape(log: &Log, topic_count: usize, data_length: usize, name: &str) -> Result<(), Error> {
+    if log.topics.len() != topic_count || log.data.len() != data_length {
+        return Err(Error::msg(format!("malformed recognized {name} event")));
+    }
+    Ok(())
+}
+
+fn validate_sha256(field: &str, value: &str) -> Result<(), Error> {
+    if value.len() != 64
+        || !value
+            .bytes()
+            .all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+    {
+        return Err(Error::msg(format!("{field} must be a lowercase SHA-256")));
+    }
+    Ok(())
+}
+
+fn validate_cid(field: &str, value: &str) -> Result<(), Error> {
+    if value.len() != 46 || !value.starts_with("Qm") || !value.bytes().all(|byte| byte.is_ascii_alphanumeric()) {
+        return Err(Error::msg(format!("{field} must be a CIDv0 string")));
+    }
+    Ok(())
+}
