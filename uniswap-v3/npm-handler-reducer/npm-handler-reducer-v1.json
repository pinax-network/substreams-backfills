    "transaction_metadata": "one exact host-only gas-limit and gas-price record per referenced transaction hash; receipt gas is excluded",
    "legacy_stored_gas_used": "apiVersion 0.0.4 writes the transaction gas_limit exposed to the mapping as event.transaction.gasUsed",
