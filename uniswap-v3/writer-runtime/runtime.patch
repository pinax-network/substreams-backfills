+
+    #[test]
+    fn recognized_malformed_events_fail_and_unknown_signatures_continue() {
+        let malformed = Log {
+            topics: vec![hex::decode(INCREASE_TOPIC).unwrap()],
+            ..Default::default()
+        };
+        assert_eq!(
+            decode_writer_log(&malformed).unwrap_err().to_string(),
+            "malformed recognized IncreaseLiquidity event"
+        );
