+    fn base_runtime_origin_and_npm_gate_are_distinct_at_all_boundaries() {
+        let fixture = case("base-npm-gate");
+        let base = config("base");
+        assert_eq!(base.initial_blocks.module, 1_371_679);
+        assert_eq!(base.initial_blocks.factory, 1_371_679);
+        assert_eq!(base.initial_blocks.factory_creation, 1_371_679);
+        assert_eq!(base.initial_blocks.nonfungible_position_manager, 1_371_713);
+
+        let mut candidate = block(&fixture);
+        candidate.number = 1_371_678;
+        assert!(extract_writer_events(&base, &candidate).is_err());
+        for number in [1_371_679, 1_371_712] {
+            candidate.number = number;
+            assert!(extract_writer_events(&base, &candidate).unwrap().events.is_empty());
+        }
+        candidate.number = 1_371_713;
+        assert_eq!(extract_writer_events(&base, &candidate).unwrap().events.len(), 1);
