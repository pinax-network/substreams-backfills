target/
*.spkg
!artifacts/releases/uniswap-v4/**/*.spkg
__pycache__/
*.py[cod]

# Externalized evidence assets (see docs/evidence-assets.md). Fetched copies are
# placed at their original paths by `cargo xtask evidence fetch`; never commit them.
uniswap-v3/all-handlers/v1/contract.json
uniswap-v3/factory-static/v2/contract.json
uniswap-v3/graft-ancestry/v1/contract.json
uniswap-v3/graft-ancestry/v2/contract.json
uniswap-v3/npm-collect/v2/contract.json
uniswap-v3/npm-liquidity/v2/contract.json
uniswap-v3/npm-transfer/v2/contract.json
uniswap-v3/pool-burn/v1/contract.json
uniswap-v3/pool-burn/v2/contract.json
uniswap-v3/pool-flash/v2/contract.json
uniswap-v3/pool-initialize/v2/contract.json
uniswap-v3/pool-mint/v1/contract.json
uniswap-v3/pool-mint/v2/contract.json
uniswap-v3/pool-swap/v2/contract.json
uniswap-v3/segment-field-semantics/v2/contract.json
uniswap-v3/segment-writer-matrix/v1/contract.json

# Block fixtures (see uniswap-v3/fixtures/README.md); hydrated by `cargo xtask evidence fetch --lock uniswap-v3/fixtures/blocks.lock.json`
uniswap-v3/fixtures/blocks/**/*.pb

# Aerodrome Slipstream Base block fixtures; hydrated by
# `cargo xtask evidence fetch --lock aerodrome-slipstream-base/fixtures/blocks.lock.json`
aerodrome-slipstream-base/fixtures/blocks/**/*.pb

# Aerodrome root-window run artifacts (see mapping-host/README.md); hydrated by
# `cargo xtask evidence fetch --lock mapping-host/evidence/aerodrome-root-window.lock.json`
# and, outside CI, `--lock mapping-host/evidence/aerodrome-root-window-archive.lock.json`.
# The committed files are the two `.json` summaries and the two locks.
mapping-host/evidence/aerodrome-*.jsonl
mapping-host/evidence/aerodrome-*.cassette.json
mapping-host/evidence/aerodrome-*.store.json
mapping-host/evidence/aerodrome-*.bcf1
