+
+impl SegmentProfiles {
+    fn embedded(config: &ChainConfig) -> Result<Self, Error> {
+        let raw = include_str!("../configs/segment-profiles-v1.json");
+        let digest = hex::encode(Sha256::digest(raw.as_bytes()));
+        if digest != PROFILE_SET_SHA256 || digest != config.writer_runtime.segment_profiles_sha256 {
+            return Err(Error::msg("writer-runtime segment-profile digest mismatch"));
+        }
+        Self::parse_and_validate(raw)
+    }
+
+    fn parse_and_validate(raw: &str) -> Result<Self, Error> {
+        if hex::encode(Sha256::digest(raw.as_bytes())) != PROFILE_SET_SHA256 {
+            return Err(Error::msg("unapproved writer-runtime segment-profile digest"));
+        }
+        let profiles: Self = serde_json::from_str(raw)
+            .map_err(|error| Error::msg(format!("invalid writer-runtime profile JSON: {error}")))?;
+        profiles.validate()?;
+        Ok(profiles)
+    }
+
+    fn validate(&self) -> Result<(), Error> {
+        if self.format_version != 1 || self.profile_contract_version != PROFILE_CONTRACT_VERSION {
+            return Err(Error::msg("unsupported writer-runtime segment-profile version"));
+        }
+        if self.source_writer_contract.contract_version != SOURCE_CONTRACT_VERSION
+            || self.source_writer_contract.path != SOURCE_CONTRACT_PATH
+            || self.source_writer_contract.raw_sha256 != SOURCE_WRITER_CONTRACT_SHA256
+        {
+            return Err(Error::msg("writer-runtime source-contract binding drift"));
+        }
+        if self.source_truth_boundary != EXPECTED_SOURCE_TRUTH || self.tranche_truth_boundary != EXPECTED_TRANCHE_TRUTH
+        {
+            return Err(Error::msg("writer-runtime truth boundary drift"));
+        }
+
+        const EXPECTED_RANGES: &[(Network, u64, Option<u64>)] = &[
+            (Network::Mainnet, 12_369_621, Some(13_450_880)),
+            (Network::Mainnet, 13_450_881, Some(13_498_328)),
+            (Network::Mainnet, 13_498_329, Some(13_591_197)),
+            (Network::Mainnet, 13_591_198, Some(13_605_860)),
+            (Network::Mainnet, 13_605_861, Some(19_470_000)),
+            (Network::Mainnet, 19_470_001, None),
+            (Network::Base, 1_371_679, Some(19_852_000)),
+            (Network::Base, 19_852_001, None),
+        ];
+        if self.profiles.len() != EXPECTED_RANGES.len() {
+            return Err(Error::msg("writer-runtime requires exactly eight ordered segments"));
+        }
+        for (profile, expected) in self.profiles.iter().zip(EXPECTED_RANGES) {
+            if (
+                profile.network,
+                profile.start_block_inclusive,
+                profile.end_block_inclusive,
+            ) != *expected
+            {
+                return Err(Error::msg("writer-runtime segment range or order drift"));
+            }
+            for (field, value) in [
+                ("deployment", profile.deployment.as_str()),
+                ("factory_mapping_cid", profile.factory_mapping_cid.as_str()),
+                ("pool_mapping_cid", profile.pool_mapping_cid.as_str()),
+                ("npm_mapping_cid", profile.npm_mapping_cid.as_str()),
+            ] {
+                validate_cid(field, value)?;
+            }
+            for (field, value) in [
+                ("source_segment_sha256", profile.source_segment_sha256.as_str()),
+                ("artifact_identity_sha256", profile.artifact_identity_sha256.as_str()),
+                ("semantic_contract_sha256", profile.semantic_contract_sha256.as_str()),
+            ] {
+                validate_sha256(field, value)?;
+            }
+            if profile.segment_id != format!("{}:{}", profile.network.as_str(), profile.deployment)
+                || profile.factory_profile_id.is_empty()
+                || profile.pool_profile_id.is_empty()
+                || profile.npm_profile_id.is_empty()
+                || profile.execution_model != ExecutionModel::Undecided
+                || profile.target_runtime_identity_bound
+                || profile.backfill_allowed
+                || profile.npm_full_handler_or_field_writer_audit_complete
+                || profile.historical_guard.block != 14_317_993
+                || (profile.historical_guard.effective_in_segment && !profile.historical_guard.present_in_mapping)
+            {
+                return Err(Error::msg("writer-runtime segment binding or conservative gate drift"));
+            }
+        }
+        Ok(())
+    }
+
+    fn select(&self, network: Network, block: u64) -> Result<&SegmentProfile, Error> {
+        let mut matches = self.profiles.iter().filter(|profile| profile.includes(network, block));
+        let profile = matches.next().ok_or_else(|| {
+            Error::msg(format!(
+                "no writer-runtime segment for {} block {block}",
+                network.as_str()
+            ))
+        })?;
+        if matches.next().is_some() {
+            return Err(Error::msg(format!(
+                "overlapping writer-runtime segments for {} block {block}",
+                network.as_str()
+            )));
+        }
+        Ok(profile)
+    }
+}
