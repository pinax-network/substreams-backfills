+            amount0: String,
+            amount1: String,
+        },
+        Transfer {
+            from: String,
+            to: String,
+            token_id: String,
+        },
+    }
+
+    fn fixtures() -> Fixtures {
+        let fixtures: Fixtures = serde_json::from_str(include_str!("../fixtures/events-v1.json")).unwrap();
+        assert_eq!(fixtures.format_version, 1);
+        assert_eq!(fixtures.fixture_version, "uniswap-v3-writer-events-fixtures/v1");
+        assert!(fixtures.quantity_encoding.contains("unscaled unsigned ABI integers"));
+        assert_eq!(fixtures.addresses.mainnet_nonfungible_position_manager.len(), 40);
+        assert_eq!(fixtures.addresses.base_nonfungible_position_manager.len(), 40);
+        assert_eq!(fixtures.addresses.foreign.len(), 40);
+        fixtures
+    }
+
+    fn config(network: &str) -> ChainConfig {
+        ChainConfig::from_params(match network {
+            "mainnet" => MAINNET_PARAMS,
+            "base" => BASE_PARAMS,
+            _ => panic!("unsupported fixture network"),
+        })
+        .unwrap()
+    }
+
+    fn case(id: &str) -> FixtureCase {
+        fixtures().cases.into_iter().find(|case| case.id == id).unwrap()
+    }
+
+    fn block(case: &FixtureCase) -> Block {
+        Block {
+            number: case.block_number,
+            transaction_traces: case
+                .transactions
+                .iter()
+                .map(|transaction| TransactionTrace {
+                    hash: hex::decode(&transaction.hash).unwrap(),
+                    status: transaction.status,
+                    receipt: Some(TransactionReceipt {
+                        logs: transaction
+                            .logs
+                            .iter()
+                            .enumerate()
+                            .map(|(index, log)| fixture_log(log, index as u32))
+                            .collect(),
+                        ..Default::default()
+                    }),
+                    ..Default::default()
+                })
+                .collect(),
+            ..Default::default()
+        }
+    }
+
+    fn fixture_log(fixture: &FixtureLog, index: u32) -> Log {
+        let (topic, mut topics, data) = match &fixture.event {
+            FixtureEvent::Increase {
+                token_id,
+                liquidity,
+                amount0,
+                amount1,
+            } => (
+                INCREASE_TOPIC,
+                vec![word(token_id)],
+                words(&[liquidity, amount0, amount1]),
+            ),
+            FixtureEvent::Decrease {
+                token_id,
+                liquidity,
+                amount0,
+                amount1,
+            } => (
+                DECREASE_TOPIC,
+                vec![word(token_id)],
+                words(&[liquidity, amount0, amount1]),
+            ),
+            FixtureEvent::Collect {
+                token_id,
+                recipient,
+                amount0,
+                amount1,
+            } => (
+                COLLECT_TOPIC,
+                vec![word(token_id)],
+                [address_word(recipient), word(amount0), word(amount1)].concat(),
+            ),
+            FixtureEvent::Transfer { from, to, token_id } => (
+                TRANSFER_TOPIC,
+                vec![address_word(from), address_word(to), word(token_id)],
+                Vec::new(),
+            ),
+        };
+        topics.insert(0, hex::decode(topic).unwrap());
+        Log {
+            address: hex::decode(&fixture.address).unwrap(),
+            topics,
+            data,
+            index,
+            block_index: 100 + index,
+            ordinal: fixture.ordinal,
+        }
+    }
+
+    fn word(value: &str) -> Vec<u8> {
+        let value = U256::from_dec_str(value).unwrap();
+        let mut output = [0; 32];
+        value.to_big_endian(&mut output);
+        output.to_vec()
+    }
+
+    fn address_word(value: &str) -> Vec<u8> {
+        let mut output = vec![0; 12];
+        output.extend(hex::decode(value).unwrap());
+        output
+    }
+
+    fn words(values: &[&String]) -> Vec<u8> {
+        values.iter().flat_map(|value| word(value)).collect()
+    }
+
+    fn event_type(event: &WriterEvent) -> &'static str {
+        match event.event.as_ref().unwrap() {
+            Event::IncreaseLiquidity(_) => "increase",
+            Event::DecreaseLiquidity(_) => "decrease",
+            Event::Collect(_) => "collect",
+            Event::Transfer(_) => "transfer",
+        }
+    }
+
+    #[test]
+    fn fixture_contract_retains_all_occurrences_in_global_ordinal_order() {
+        for case in fixtures().cases {
+            let output = extract_writer_events(&config(&case.network), &block(&case)).unwrap();
+            assert_eq!(
+                output.events.iter().map(|event| event.ordinal).collect::<Vec<_>>(),
+                case.expected_ordinals,
+                "{} ordinals",
+                case.id
+            );
+            assert_eq!(
+                output.events.iter().map(event_type).collect::<Vec<_>>(),
+                case.expected_types,
+                "{} types",
+                case.id
+            );
+        }
+    }
+
+    #[test]
+    fn transfer_only_foreign_logs_failed_transactions_and_cross_network_addresses_are_handled() {
+        let transfer = case("transfer-only-mainnet");
+        let output = extract_writer_events(&config("mainnet"), &block(&transfer)).unwrap();
+        assert_eq!(output.events.len(), 1);
+        assert!(matches!(output.events[0].event, Some(Event::Transfer(_))));
+
+        let all = case("all-occurrences-global-order-and-filtering-mainnet");
+        let output = extract_writer_events(&config("mainnet"), &block(&all)).unwrap();
+        assert_eq!(output.events.len(), 5);
+        assert!(!output.events.iter().any(|event| event.ordinal == 5));
+        assert!(!output.events.iter().any(|event| event.ordinal == 12));
+        assert!(!output.events.iter().any(|event| event.ordinal == 15));
+    }
+
+    #[test]
+    fn raw_uint256_values_and_log_identity_are_unchanged() {
+        let all = case("all-occurrences-global-order-and-filtering-mainnet");
+        let output = extract_writer_events(&config("mainnet"), &block(&all)).unwrap();
+        let event = output.events.iter().find(|event| event.ordinal == 50).unwrap();
+        let Event::IncreaseLiquidity(increase) = event.event.as_ref().unwrap() else {
+            panic!("expected IncreaseLiquidity");
+        };
+        assert_eq!(increase.liquidity, "340282366920938463463374607431768211455");
+        assert_eq!(
+            increase.amount0,
+            "115792089237316195423570985008687907853269984665640564039457584007913129639935"
+        );
+        assert_eq!(increase.amount1, "9007199254740993");
+        assert_eq!(event.block_number, 14_317_993);
+        assert_eq!(event.contract_address, config("mainnet").position_manager_address());
+        assert_eq!(event.transaction_hash, vec![0xbb; 32]);
+        assert_eq!(event.transaction_log_index, 0);
+        assert_eq!(event.block_log_index, 100);
