+// @generated and checked in for the pinned prost 0.13.3 wire contract.
+#[allow(clippy::derive_partial_eq_without_eq)]
+#[derive(Clone, PartialEq, ::prost::Message)]
+pub struct WriterEvents {
+    #[prost(message, repeated, tag = "1")]
+    pub events: ::prost::alloc::vec::Vec<WriterEvent>,
+    #[prost(string, tag = "2")]
+    pub network: ::prost::alloc::string::String,
+    #[prost(uint64, tag = "3")]
+    pub block_number: u64,
+    #[prost(string, tag = "4")]
+    pub segment_id: ::prost::alloc::string::String,
+    #[prost(string, tag = "5")]
+    pub source_writer_contract_sha256: ::prost::alloc::string::String,
+    #[prost(string, tag = "6")]
+    pub segment_semantic_contract_sha256: ::prost::alloc::string::String,
+}
+
+#[allow(clippy::derive_partial_eq_without_eq)]
+#[derive(Clone, PartialEq, ::prost::Message)]
+pub struct WriterEvent {
+    #[prost(uint64, tag = "1")]
+    pub ordinal: u64,
+    #[prost(bytes = "vec", tag = "2")]
+    pub transaction_hash: ::prost::alloc::vec::Vec<u8>,
+    #[prost(uint64, tag = "3")]
+    pub block_number: u64,
+    #[prost(uint32, tag = "4")]
+    pub transaction_log_index: u32,
+    #[prost(uint32, tag = "5")]
+    pub block_log_index: u32,
+    #[prost(bytes = "vec", tag = "6")]
+    pub contract_address: ::prost::alloc::vec::Vec<u8>,
+    #[prost(oneof = "writer_event::Event", tags = "10, 11, 12, 13")]
+    pub event: ::core::option::Option<writer_event::Event>,
+}
+
+pub mod writer_event {
+    #[allow(clippy::derive_partial_eq_without_eq)]
+    #[derive(Clone, PartialEq, ::prost::Oneof)]
+    pub enum Event {
+        #[prost(message, tag = "10")]
+        IncreaseLiquidity(super::IncreaseLiquidity),
+        #[prost(message, tag = "11")]
+        DecreaseLiquidity(super::DecreaseLiquidity),
+        #[prost(message, tag = "12")]
+        Collect(super::Collect),
+        #[prost(message, tag = "13")]
+        Transfer(super::Transfer),
+    }
