diff --git a/proto/uniswap/v1/writer.proto b/proto/uniswap/v1/writer.proto
new file mode 100644
index 0000000..efebb63
--- /dev/null
+++ b/proto/uniswap/v1/writer.proto
@@ -0,0 +1,55 @@
+syntax = "proto3";
+
+package uniswap.writer.v1;
+
+// Diagnostic raw NonfungiblePositionManager events. This stream is not graph_out.
+message WriterEvents {
+  repeated WriterEvent events = 1;
+  string network = 2;
+  uint64 block_number = 3;
+  string segment_id = 4;
+  string source_writer_contract_sha256 = 5;
+  string segment_semantic_contract_sha256 = 6;
+}
+
+message WriterEvent {
+  uint64 ordinal = 1;
+  bytes transaction_hash = 2;
+  uint64 block_number = 3;
+  uint32 transaction_log_index = 4;
+  uint32 block_log_index = 5;
+  bytes contract_address = 6;
+  oneof event {
+    IncreaseLiquidity increase_liquidity = 10;
+    DecreaseLiquidity decrease_liquidity = 11;
+    Collect collect = 12;
+    Transfer transfer = 13;
+  }
+}
+
+message IncreaseLiquidity {
+  string token_id = 1;
+  string liquidity = 2;
+  string amount0 = 3;
+  string amount1 = 4;
+}
+
+message DecreaseLiquidity {
+  string token_id = 1;
+  string liquidity = 2;
+  string amount0 = 3;
+  string amount1 = 4;
+}
+
+message Collect {
+  string token_id = 1;
+  bytes recipient = 2;
+  string amount0 = 3;
+  string amount1 = 4;
+}
+
+message Transfer {
+  bytes from = 1;
+  bytes to = 2;
+  string token_id = 3;
+}
