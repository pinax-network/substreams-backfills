+    #[test]
+    fn selector_covers_every_inclusive_boundary_and_rejects_gaps_or_overlaps() {
+        let profiles = SegmentProfiles::embedded(&config("mainnet")).unwrap();
+        for profile in &profiles.profiles {
+            assert_eq!(
+                profiles
+                    .select(profile.network, profile.start_block_inclusive)
+                    .unwrap()
+                    .segment_id,
+                profile.segment_id
+            );
+            if let Some(end) = profile.end_block_inclusive {
+                assert_eq!(
+                    profiles.select(profile.network, end).unwrap().segment_id,
+                    profile.segment_id
+                );
+            }
+        }
+        assert!(profiles.select(Network::Mainnet, 12_369_620).is_err());
+        assert!(profiles.select(Network::Base, 1_371_678).is_err());
+
+        let mut gap = profiles.clone();
+        gap.profiles[1].start_block_inclusive += 1;
+        assert!(gap.validate().is_err());
+        let mut overlap = profiles.clone();
+        overlap.profiles[1].start_block_inclusive -= 1;
+        assert!(overlap.validate().is_err());
+        let mut missing = profiles.clone();
+        missing.profiles.pop();
+        assert!(missing.validate().is_err());
+        let mut extra = profiles.clone();
+        extra.profiles.push(extra.profiles[0].clone());
+        assert!(extra.validate().is_err());
+        let mut reordered = profiles.clone();
+        reordered.profiles.swap(0, 1);
+        assert!(reordered.validate().is_err());
+    }
